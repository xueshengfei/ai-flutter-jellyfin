# See https://dart.dev/guides/libraries/private-files

# Files generated by dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Claude Code 本地配置
.claude/settings.local.json

# Files generated by build_runner
*.g.dart
*.freezed.dart

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test outputs (不忽略 test/ 源码目录，那是 Flutter 测试代码必须进 git)
test_results/
test_reports/
**/test_report/
**/test_output/

# OpenHarmony / OHOS 依赖与构建缓存（类似 node_modules / .gradle）
**/oh_modules/
**/.ohpm/
**/.hvigor/
**/ohos/**/node_modules/

# Flutter OHOS 编译产物（kernel_blob.bin/isolate_snapshot 等，类似 .apk 中间产物）
**/rawfile/flutter_assets/

# OHOS 本机 SDK 路径配置（类似 Android local.properties，含个人用户路径）
**/ohos/local.properties

# Coverage
coverage/

# Logs
*.log

# Local thesis deliverables and source-document scratch copies
docs/thesis_versions/
docs/thesis_source_extracted.txt
docs/thesis_source_opening_report.docx
docs/thesis_template_extracted.txt
docs/xupt_thesis_template.docx
scripts/generate_thesis_versions.py
scripts/generate_xupt_template_thesis.py
scripts/generate_thesis_diagrams.py
scripts/build_diagram_pack_docx.py

